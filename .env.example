# OpenAI API key for resume tailoring and cover letter generation
OPENAI_API_KEY=sk-your-key-here

# Adzuna API credentials (free at https://developer.adzuna.com/)
ADZUNA_APP_ID=your-app-id
ADZUNA_APP_KEY=your-app-key

# Job search preferences
JOB_SEARCH_KEYWORDS=software engineer,python developer,backend engineer
JOB_SEARCH_LOCATION=United States
JOB_SEARCH_REMOTE_ONLY=false

# Path to your base resume (JSON format)
RESUME_PATH=data/sample_resume.json
