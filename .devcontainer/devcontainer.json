{
    "name": "Job Search Agent",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "postCreateCommand": "pip install -q . && cp -n .env.example .env 2>/dev/null; true",
    "postStartCommand": "python -m app.main",
    "forwardPorts": [8000],
    "portsAttributes": {
        "8000": {
            "label": "Job Search Agent",
            "onAutoForward": "openBrowser"
        }
    },
    "customizations": {
        "codespaces": {
            "openFiles": []
        }
    }
}
